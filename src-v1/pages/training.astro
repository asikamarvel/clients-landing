---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TrainingCard from '@components/TrainingCard.astro';
import CTABanner from '@components/CTABanner.astro';
import { trainingTracks } from '@data/training';
---

<Layout
  title="Training"
  description="Professional tech training with a spotlight on AI, machine learning, and agentic systems. Industry-aligned curriculum for individuals and teams."
>
  <Hero
    headline="Serious Tech Training for the <span class='text-gradient'>AI Era</span>"
    subtitle="Standard curriculum. Practicing instructors. Real-world projects. Our training programs build professionals who can deliver — not just follow tutorials."
    compact
    backgroundImage="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=1400&q=80"
    primaryCTA={{ label: 'Inquire About Training', href: '/contact/' }}
  />

  <!-- Why Our Training -->
  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="Why Omaxil Training"
        title="Training That Actually Works"
        subtitle="We don't do fluff. Every program is designed to produce professionals who can walk into a real project and contribute from day one."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Standard Curriculum', desc: 'Industry-aligned syllabi developed by engineers actively building in the field, not recycled course content.' },
          { title: 'Hands-On Focus', desc: 'Every module includes real-world projects. You build things, you break things, you learn by doing.' },
          { title: 'AI Spotlight', desc: 'Dedicated tracks on AI, LLMs, agents, and prompt engineering — the technologies defining the next decade.' },
          { title: 'Corporate Ready', desc: 'Team training packages with custom curricula, on-site or remote delivery, and progress reporting.' },
        ].map((item) => (
          <div class="card-surface p-6">
            <h3 class="text-lg font-display font-semibold text-text-primary mb-2">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Training Tracks -->
  <section class="section-padding bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="Programs"
        title="Training Tracks"
        subtitle="Choose your path. Each track is structured as a progressive curriculum with assessments and project milestones."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {trainingTracks.map((track) => (
          <TrainingCard
            icon={track.icon}
            title={track.title}
            topics={track.topics}
            featured={track.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- AI Deep Dive -->
  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative order-2 lg:order-1">
          <img
            src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&q=80"
            alt="AI and machine learning"
            class="rounded-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/5"></div>
        </div>
        <div class="order-1 lg:order-2">
          <span class="inline-block text-accent text-sm font-semibold tracking-widest uppercase mb-4">AI Spotlight</span>
          <h2 class="text-section-title font-display font-semibold text-text-primary">
            The AI & Machine Learning <span class="text-gradient">Track</span>
          </h2>
          <p class="mt-4 text-text-secondary leading-relaxed">
            This is not a surface-level AI overview. Our dedicated AI track takes professionals from foundational concepts to building production-ready AI agents and agentic systems. The curriculum evolves as quickly as the technology does.
          </p>
          <ul class="mt-6 space-y-3">
            {[
              'Prompt engineering — from basics to advanced chain-of-thought techniques',
              'Building AI agents with tool use, memory, and multi-step reasoning',
              'LLM integration into existing business applications',
              'Multi-agent (agentic) system architecture and orchestration',
              'Responsible AI practices, bias detection, and ethical deployment',
              'Generative AI applications — text, code, image, and data',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm">
                <span class="mt-0.5 text-accent shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="text-text-secondary">{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <a href="/contact/" class="btn-primary">Enroll in AI Training</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="Process"
        title="How Enrollment Works"
        subtitle="Getting started is simple."
      />
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {[
          { step: '01', title: 'Inquire', desc: 'Reach out via our contact form or email. Tell us which track interests you.' },
          { step: '02', title: 'Assess', desc: 'We evaluate your current level to place you in the right cohort and track.' },
          { step: '03', title: 'Learn', desc: 'Structured modules with live instruction, hands-on projects, and regular assessments.' },
          { step: '04', title: 'Certify', desc: 'Complete your capstone project and earn your certificate of completion.' },
        ].map((item) => (
          <div class="card-surface p-6 text-center">
            <span class="text-3xl font-display font-bold text-accent/20">{item.step}</span>
            <h3 class="mt-3 text-lg font-display font-semibold text-text-primary">{item.title}</h3>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    headline="Ready to upskill?"
    subtitle="Whether for yourself or your entire team, let's find the right training path for you."
    buttonLabel="Inquire About Training"
  />
</Layout>
