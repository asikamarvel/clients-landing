---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import PartnerLogos from '@components/PartnerLogos.astro';
import CTABanner from '@components/CTABanner.astro';
import { services } from '@data/services';
---

<Layout title="Home">
  <!-- Hero -->
  <Hero
    headline='We Engineer Digital Solutions <span class="text-gradient">That Scale</span>'
    subtitle="From web design to AI agents, ERP systems to professional training — we help businesses across the US, Europe, and Africa build, transform, and grow with technology."
    primaryCTA={{ label: 'Explore Services', href: '/services/' }}
    secondaryCTA={{ label: 'Get in Touch', href: '/contact/' }}
    backgroundImage="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1400&q=80"
  />

  <!-- Partners -->
  <PartnerLogos />

  <!-- Services -->
  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="What We Do"
        title="End-to-End Technology Services"
        subtitle="Six core pillars built around one mission: helping your business thrive in the digital era."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <ServiceCard
            icon={service.icon}
            title={service.shortTitle}
            description={service.tagline}
            href={`/services/${service.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Training Spotlight -->
  <section class="section-padding bg-surface-50/50">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block text-accent text-sm font-medium tracking-widest uppercase mb-4">Training Academy</span>
          <h2 class="text-section-title font-display font-semibold text-text-primary">
            Serious Tech Training for the <span class="text-gradient">AI Era</span>
          </h2>
          <p class="mt-4 text-lg text-text-secondary leading-relaxed">
            Our structured curriculum goes beyond tutorials. We train professionals and teams on the technologies shaping the future — with a dedicated spotlight on AI, machine learning, and agentic systems.
          </p>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-1 text-accent shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="text-text-secondary">Industry-aligned curriculum developed by practicing engineers</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-accent shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="text-text-secondary">Hands-on projects with real-world applications, not toy examples</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-accent shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="text-text-secondary">Dedicated AI & ML track covering agents, LLMs, and prompt engineering</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 text-accent shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="text-text-secondary">Corporate training packages for upskilling your entire team</span>
            </li>
          </ul>
          <div class="mt-10">
            <a href="/training/" class="btn-primary">Explore Training Programs</a>
          </div>
        </div>
        <div class="relative">
          <img
            src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&q=80"
            alt="Tech training session"
            class="rounded-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/5"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="Our Process"
        title="How We Work"
        subtitle="A proven, transparent process that keeps you informed and in control at every stage."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { step: '01', title: 'Discover', desc: 'We listen first. Deep-dive sessions to understand your business, your goals, and the challenges standing in the way.' },
          { step: '02', title: 'Build', desc: 'Our teams design and develop with precision — iterating fast, communicating often, and delivering on spec.' },
          { step: '03', title: 'Deliver & Support', desc: 'We launch, we monitor, and we stay. Post-delivery support ensures everything runs smoothly.' },
        ].map((item) => (
          <div class="card-surface p-8 text-center">
            <span class="text-4xl font-display font-bold text-accent/20">{item.step}</span>
            <h3 class="mt-4 text-xl font-display font-semibold text-text-primary">{item.title}</h3>
            <p class="mt-3 text-text-secondary text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Omaxil -->
  <section class="section-padding bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="Why Omaxil"
        title="What Sets Us Apart"
        subtitle="We're not just service providers. We're partners invested in your success."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Global Reach', desc: 'Based in Nigeria, serving clients across the US, UK, Europe, and Africa. We bridge time zones and cultures.' },
          { title: 'Expert Team', desc: 'Senior engineers, designers, and consultants with deep experience across industries and technologies.' },
          { title: 'Proven Process', desc: 'Transparent, agile methodology that keeps projects on track, on budget, and clearly communicated.' },
          { title: 'Ongoing Support', desc: "We don't disappear after launch. Long-term partnerships with dedicated support and continuous improvement." },
        ].map((item) => (
          <div class="card-surface p-6">
            <h3 class="text-lg font-display font-semibold text-text-primary mb-2">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner />
</Layout>
