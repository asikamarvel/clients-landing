---
import { partners } from '@data/partners';
---

<section class="py-section-sm border-y border-surface-300/50">
  <div class="max-w-site mx-auto w-full px-6 md:px-8">
    <p class="text-center text-text-muted text-sm uppercase tracking-widest mb-10">
      Trusted by organizations across industries
    </p>
    <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
      {partners.map((partner) => (
        <div class="text-text-muted/50 text-lg font-display font-medium hover:text-text-secondary transition-colors duration-300 cursor-default">
          {partner.name}
        </div>
      ))}
    </div>
  </div>
</section>
