---
interface Props {
  icon: string;
  title: string;
  topics: string[];
  featured?: boolean;
}

const { icon, title, topics, featured = false } = Astro.props;
---

<div class:list={['card-surface p-8 transition-all duration-300 hover:bg-surface-200', featured && 'border-accent/30 ring-1 ring-accent/10']}>
  <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent mb-4">
    <Fragment set:html={icon} />
  </div>
  <h3 class="text-lg font-display font-semibold text-text-primary mb-3">{title}</h3>
  {featured && (
    <span class="inline-block text-xs font-semibold text-accent bg-accent/10 px-2.5 py-1 rounded-full mb-3 uppercase tracking-wider">
      Spotlight
    </span>
  )}
  <ul class="space-y-2">
    {topics.map((topic) => (
      <li class="flex items-start gap-2 text-sm text-text-secondary">
        <span class="text-accent mt-0.5 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        {topic}
      </li>
    ))}
  </ul>
</div>
