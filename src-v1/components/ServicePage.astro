---
import type { Service } from '@data/services';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import CTABanner from '@components/CTABanner.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<Layout title={service.title} description={service.description}>
  <Hero
    headline={`${service.tagline}`}
    subtitle={service.description.slice(0, 160) + '...'}
    compact
    backgroundImage={service.heroImage}
    primaryCTA={{ label: 'Get a Quote', href: '/contact/' }}
    secondaryCTA={{ label: 'All Services', href: '/services/' }}
  />

  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <SectionHeading label="Overview" title="What We Do" align="left" />
          <p class="text-text-secondary leading-relaxed -mt-8">{service.description}</p>
        </div>
        <div>
          <SectionHeading label="Deliverables" title="What You Get" align="left" />
          <ul class="space-y-3 -mt-8">
            {service.offerings.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 text-accent shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="text-text-secondary">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <SectionHeading
        label="Our Approach"
        title="How We Deliver"
        subtitle="A transparent process designed to keep you in control from start to finish."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {service.approach.map((step, i) => (
          <div class="card-surface p-6">
            <span class="text-2xl font-display font-bold text-accent/20">0{i + 1}</span>
            <p class="mt-3 text-sm text-text-secondary leading-relaxed">{step}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    headline={`Need ${service.shortTitle.toLowerCase()} expertise?`}
    subtitle="Let's talk about your requirements and build a plan that fits."
  />
</Layout>
