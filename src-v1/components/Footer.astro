---
const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Training', href: '/training/' },
  { label: 'Contact', href: '/contact/' },
];

const serviceLinks = [
  { label: 'Web Design & Management', href: '/services/web-design/' },
  { label: 'App Development', href: '/services/app-development/' },
  { label: 'Software & AI Agents', href: '/services/software-agents/' },
  { label: 'ERP Solutions', href: '/services/erp-solutions/' },
  { label: 'Digital Transformation', href: '/services/digital-transformation/' },
  { label: 'Tech Consultancy', href: '/services/consultancy/' },
];

const year = new Date().getFullYear();
---

<footer class="bg-surface-50 border-t border-surface-300">
  <div class="max-w-site mx-auto w-full px-6 md:px-8 py-section-sm">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div>
        <a href="/" class="text-2xl font-display font-bold text-text-primary no-underline">
          Omaxil<span class="text-accent">.</span>
        </a>
        <p class="mt-4 text-sm text-text-muted leading-relaxed">
          Engineering digital solutions that scale. From design to deployment, training to transformation.
        </p>
        <p class="mt-3 text-sm text-text-muted">Abuja, FCT, Nigeria</p>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="text-sm font-semibold text-text-primary uppercase tracking-widest mb-4">Company</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-muted hover:text-accent no-underline">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-semibold text-text-primary uppercase tracking-widest mb-4">Services</h4>
        <ul class="space-y-3">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-muted hover:text-accent no-underline">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold text-text-primary uppercase tracking-widest mb-4">Get in Touch</h4>
        <ul class="space-y-3 text-sm text-text-muted">
          <li>
            <a href="mailto:support@omaxil.com" class="hover:text-accent no-underline">support@omaxil.com</a>
          </li>
          <li>Abuja, FCT, Nigeria</li>
          <li class="text-text-muted/70">Serving clients across the US, Europe, and Africa</li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-surface-300 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-text-muted">
      <span>&copy; {year} Omaxil Tech. All rights reserved.</span>
      <div class="flex items-center gap-6">
        <a href="/feedback.html" class="hover:text-accent no-underline">Client Feedback</a>
        <span class="text-text-muted/50">Excellence | Innovation</span>
      </div>
    </div>
  </div>
</footer>
