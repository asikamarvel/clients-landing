---
const currentPath = Astro.url.pathname;

const links = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Training', href: '/training/' },
  { label: 'Contact', href: '/contact/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<nav id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-site mx-auto w-full px-6 md:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 no-underline group">
      <img src="/images/brand/Omaxil Tech.png" alt="Omaxil Tech" class="h-7 w-auto brightness-0 invert opacity-90 group-hover:opacity-100 transition-opacity" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-7">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-[13px] tracking-wide no-underline transition-colors duration-300 uppercase',
            isActive(link.href) ? 'text-text-primary' : 'text-text-muted hover:text-text-secondary',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="lg:hidden relative w-10 h-10 flex items-center justify-center text-text-secondary"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <div id="hamburger-icon" class="flex flex-col gap-[5px] transition-all duration-300">
        <span class="block w-5 h-[1.5px] bg-current transition-all duration-300 origin-center"></span>
        <span class="block w-5 h-[1.5px] bg-current transition-all duration-300"></span>
        <span class="block w-3.5 h-[1.5px] bg-current transition-all duration-300 origin-center"></span>
      </div>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-surface/98 backdrop-blur-2xl z-40 flex flex-col items-center justify-center gap-6 opacity-0 pointer-events-none transition-all duration-500 lg:hidden"
  >
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'text-2xl font-display font-light tracking-wide no-underline transition-all duration-300',
          isActive(link.href) ? 'text-text-primary' : 'text-text-muted hover:text-text-primary',
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<div class="h-16"></div>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('hamburger-icon');
  let isOpen = false;

  function handleScroll() {
    if (!nav) return;
    if (window.scrollY > 40) {
      nav.classList.add('bg-surface/90', 'backdrop-blur-lg');
    } else {
      nav.classList.remove('bg-surface/90', 'backdrop-blur-lg');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      menu?.classList.remove('opacity-0', 'pointer-events-none');
      menu?.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      const spans = icon?.querySelectorAll('span');
      if (spans) {
        spans[0].style.transform = 'rotate(45deg) translateY(3.5px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translateY(-3.5px)';
        spans[2].style.width = '1.25rem';
      }
    } else {
      menu?.classList.add('opacity-0', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      const spans = icon?.querySelectorAll('span');
      if (spans) {
        spans[0].style.transform = '';
        spans[1].style.opacity = '1';
        spans[2].style.transform = '';
        spans[2].style.width = '0.875rem';
      }
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('opacity-0', 'pointer-events-none');
      menu.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      isOpen = false;
      const spans = icon?.querySelectorAll('span');
      if (spans) {
        spans[0].style.transform = '';
        spans[1].style.opacity = '1';
        spans[2].style.transform = '';
        spans[2].style.width = '0.875rem';
      }
    });
  });
</script>
