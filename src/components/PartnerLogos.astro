---
import { partners } from '@data/partners';
---

<section class="py-12 border-y border-surface-300/30 reveal">
  <div class="max-w-site mx-auto w-full px-6 md:px-8">
    <p class="text-center text-[11px] text-text-muted/60 uppercase tracking-[0.2em] mb-8">
      Trusted partners
    </p>
    <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-4">
      {partners.map((partner) => (
        <span class="text-text-muted/40 text-[14px] font-display tracking-wide hover:text-text-muted/70 transition-colors duration-500 cursor-default">
          {partner.name}
        </span>
      ))}
    </div>
  </div>
</section>
