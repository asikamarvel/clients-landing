---
const year = new Date().getFullYear();
---

<footer class="bg-surface-50 border-t border-surface-300/50 mt-auto">
  <div class="max-w-site mx-auto w-full px-6 md:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <img src="/images/brand/Omaxil Tech.png" alt="Omaxil Tech" class="h-8 w-auto brightness-0 invert opacity-70 mb-4" />
        <p class="text-[13px] text-text-muted leading-relaxed">
          Quality software solutions and professional training. We build technology that simplifies operations and helps organizations grow.
        </p>
        <p class="mt-3 text-[13px] text-text-muted">Abuja, Nigeria</p>
      </div>

      <div>
        <h4 class="text-[11px] text-text-muted uppercase tracking-[0.15em] mb-4 font-medium">Company</h4>
        <ul class="space-y-2.5">
          {[
            { label: 'About', href: '/about/' },
            { label: 'Services', href: '/services/' },
            { label: 'Training', href: '/training/' },
            { label: 'Contact', href: '/contact/' },
          ].map((link) => (
            <li><a href={link.href} class="text-[13px] text-text-muted hover:text-text-secondary no-underline">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] text-text-muted uppercase tracking-[0.15em] mb-4 font-medium">Services</h4>
        <ul class="space-y-2.5">
          {[
            { label: 'Web Design', href: '/services/web-design/' },
            { label: 'App Development', href: '/services/app-development/' },
            { label: 'Software Solutions', href: '/services/software-agents/' },
            { label: 'ERP Solutions', href: '/services/erp-solutions/' },
            { label: 'Transformation', href: '/services/digital-transformation/' },
            { label: 'Consultancy', href: '/services/consultancy/' },
          ].map((link) => (
            <li><a href={link.href} class="text-[13px] text-text-muted hover:text-text-secondary no-underline">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] text-text-muted uppercase tracking-[0.15em] mb-4 font-medium">Contact</h4>
        <ul class="space-y-2.5 text-[13px] text-text-muted">
          <li><a href="mailto:support@omaxil.com" class="hover:text-text-secondary no-underline">support@omaxil.com</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-surface-300/30 flex flex-col sm:flex-row justify-between items-center gap-3">
      <span class="text-[12px] text-text-muted/60">&copy; {year} Omaxil Tech. All rights reserved.</span>
      <a href="/feedback.html" class="text-[12px] text-text-muted/60 hover:text-text-muted no-underline">Client Feedback</a>
    </div>
  </div>
</footer>
