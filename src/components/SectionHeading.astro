---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { label, title, subtitle, align = 'center' } = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center mx-auto' : '', 'max-w-narrow mb-14']}>
  {label && (
    <span class="inline-block text-[11px] text-text-muted uppercase tracking-[0.2em] mb-3 font-medium">
      {label}
    </span>
  )}
  <h2 class="text-section-title font-display font-light text-text-primary">{title}</h2>
  {subtitle && (
    <p class="mt-3 text-[15px] text-text-secondary leading-relaxed font-light">{subtitle}</p>
  )}
</div>
