---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CTABanner from '@components/CTABanner.astro';
import { services } from '@data/services';
---

<Layout title="Services" description="Technology services from Omaxil Tech — web and app development, enterprise systems, software solutions, digital transformation, and consultancy.">
  <Hero
    headline="Solutions built to solve real problems"
    subtitle="From web applications to enterprise software — we build technology that streamlines operations, reduces costs, and helps your business grow."
    compact
    primaryCTA={{ label: 'Request a Consultation', href: '/contact/' }}
  />

  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="reveal">
        <SectionHeading
          label="Our Services"
          title="What we build"
          subtitle="Six integrated practice areas, each focused on delivering measurable outcomes."
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 stagger">
        {services.map((service) => (
          <div class="reveal">
            <ServiceCard
              icon={service.icon}
              title={service.title}
              description={service.tagline}
              href={`/services/${service.slug}/`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8 text-center reveal">
      <h2 class="text-section-title font-display font-light text-text-primary">Tech training for teams</h2>
      <p class="mt-3 text-[15px] text-text-secondary max-w-xl mx-auto font-light">Beyond building solutions, we train teams on modern software development, cloud technologies, and emerging tools. Our programs build practical skills that drive real results.</p>
      <div class="mt-6"><a href="/training/" class="btn-secondary">View Training Programs</a></div>
    </div>
  </section>

  <CTABanner headline="Have a project in mind?" subtitle="Share what you are trying to achieve and we will outline how we can help." buttonLabel="Start a Conversation" />
</Layout>
