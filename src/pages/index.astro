---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import PartnerLogos from '@components/PartnerLogos.astro';
import CTABanner from '@components/CTABanner.astro';
import { services } from '@data/services';
---

<Layout title="Home">
  <Hero
    headline="Technology that drives results"
    subtitle="Omaxil Tech builds software solutions that simplify operations, reduce costs, and help businesses scale. From web applications to enterprise systems — we deliver technology that works."
    primaryCTA={{ label: 'Explore Services', href: '/services/' }}
    secondaryCTA={{ label: 'Get in Touch', href: '/contact/' }}
    backgroundImage="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1400&q=80"
  />

  <PartnerLogos />

  <!-- Services -->
  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="reveal">
        <SectionHeading
          label="Services"
          title="What we build"
          subtitle="Web applications, mobile apps, enterprise systems, and custom software — engineered to solve real business problems."
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 stagger">
        {services.map((service) => (
          <div class="reveal">
            <ServiceCard
              icon={service.icon}
              title={service.shortTitle}
              description={service.tagline}
              href={`/services/${service.slug}/`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Omaxil -->
  <section class="section-padding bg-surface-50/40">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div class="reveal-left">
          <span class="text-[11px] text-gold uppercase tracking-[0.2em] font-medium">Why Omaxil Tech</span>
          <h2 class="mt-3 text-section-title font-display font-light text-text-primary">
            Quality technology at a cost that makes sense
          </h2>
          <p class="mt-4 text-[15px] text-text-secondary leading-relaxed font-light">
            We combine technical expertise with practical business understanding to deliver solutions that actually work. No unnecessary complexity. No inflated timelines. Just reliable software built by engineers who take pride in their craft.
          </p>
          <ul class="mt-6 space-y-3">
            {[
              'Clear communication and predictable delivery timelines',
              'Solutions designed for your budget without sacrificing quality',
              'Long-term support — we stand behind what we build',
              'Modern technology stack that scales with your growth',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[14px] text-text-secondary font-light">
                <span class="text-accent-bright/50 mt-0.5 shrink-0">&#8212;</span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <a href="/about/" class="btn-primary">About Us</a>
          </div>
        </div>
        <div class="reveal-right">
          <img
            src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80"
            alt="Technology team"
            class="rounded-xl w-full object-cover aspect-[4/3] opacity-90"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Training -->
  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div class="reveal-right order-2 lg:order-1">
          <img
            src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&q=80"
            alt="Training session"
            class="rounded-xl w-full object-cover aspect-[4/3] opacity-90"
            loading="lazy"
          />
        </div>
        <div class="reveal-left order-1 lg:order-2">
          <span class="text-[11px] text-gold uppercase tracking-[0.2em] font-medium">Training Programs</span>
          <h2 class="mt-3 text-section-title font-display font-light text-text-primary">
            Building tech skills that matter
          </h2>
          <p class="mt-4 text-[15px] text-text-secondary leading-relaxed font-light">
            We run structured training programs for individuals, teams, and organizations. Our curriculum covers web development, mobile apps, cloud infrastructure, cybersecurity, and emerging technologies — taught by practitioners who use these tools daily.
          </p>
          <ul class="mt-6 space-y-3">
            {[
              'Hands-on curriculum developed by working engineers',
              'Programs for individuals, teams, and entire organizations',
              'Partnerships with institutions to expand tech education',
              'Specialized tracks in web, mobile, cloud, and security',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[14px] text-text-secondary font-light">
                <span class="text-accent-bright/50 mt-0.5 shrink-0">&#8212;</span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <a href="/training/" class="btn-primary">View Training Programs</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section-padding bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="reveal">
        <SectionHeading
          label="Process"
          title="How we work"
          subtitle="Clear communication, iterative delivery, and genuine partnership."
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 stagger">
        {[
          { step: '01', title: 'Understand', desc: 'We start by listening. What problems are you solving? What does success look like? We map your requirements before writing any code.' },
          { step: '02', title: 'Build', desc: 'Iterative development with regular checkpoints. We keep you informed, demo progress frequently, and adjust as we learn together.' },
          { step: '03', title: 'Deploy & Support', desc: 'We launch, train your team, and stay engaged. Long-term support is standard — we are invested in your success.' },
        ].map((item) => (
          <div class="reveal card-surface p-7">
            <span class="text-[11px] text-text-muted/30 uppercase tracking-[0.15em] font-medium">{item.step}</span>
            <h3 class="mt-3 text-[16px] font-display font-normal text-text-primary">{item.title}</h3>
            <p class="mt-2 text-text-muted text-[14px] leading-relaxed font-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    headline="Ready to build something great?"
    subtitle="Let's discuss how technology can solve your business challenges."
  />
</Layout>
