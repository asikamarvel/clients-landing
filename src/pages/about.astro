---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PartnerLogos from '@components/PartnerLogos.astro';
import CTABanner from '@components/CTABanner.astro';
---

<Layout title="About" description="Omaxil Tech — a technology company delivering quality software solutions and professional training programs.">
  <Hero
    headline="Technology that works for you"
    subtitle="Omaxil Tech builds software solutions that simplify operations and drive business growth. We combine technical expertise with practical understanding to deliver results."
    compact
    backgroundImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1400&q=80"
  />

  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div class="reveal-left">
          <SectionHeading label="Our Story" title="Built on practical expertise" align="left" />
          <div class="space-y-4 text-[15px] text-text-secondary leading-relaxed font-light -mt-6">
            <p>Omaxil Tech was founded on a straightforward principle: businesses deserve technology partners who understand both code and business reality. Too many organizations overpay for solutions that underdeliver, or struggle to find reliable technical expertise they can trust.</p>
            <p>We build software that solves real problems — web applications, mobile apps, enterprise systems, and custom tools tailored to specific workflows. Our focus is always practical: what will actually help this organization operate more efficiently?</p>
            <p>Beyond building, we run professional training programs to develop technical skills within organizations. From foundational programming to advanced topics like cloud architecture and emerging technologies, our curriculum prepares teams for the demands of modern software.</p>
          </div>
        </div>
        <div class="reveal-right">
          <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&q=80" alt="Team collaboration" class="rounded-xl w-full object-cover aspect-[4/3] opacity-90" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-surface-50/30">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 stagger">
        <div class="reveal card-surface p-8">
          <span class="text-[11px] text-gold uppercase tracking-[0.15em] font-medium">Mission</span>
          <h3 class="mt-3 text-[18px] font-display font-light text-text-primary">Deliver technology that creates real value</h3>
          <p class="mt-3 text-[14px] text-text-secondary leading-relaxed font-light">To build software solutions that simplify operations and help organizations grow. We also invest in training programs that develop technical talent and expand access to quality tech education.</p>
        </div>
        <div class="reveal card-surface p-8">
          <span class="text-[11px] text-gold uppercase tracking-[0.15em] font-medium">Vision</span>
          <h3 class="mt-3 text-[18px] font-display font-light text-text-primary">Quality technology, within reach</h3>
          <p class="mt-3 text-[14px] text-text-secondary leading-relaxed font-light">A future where organizations of all sizes have access to reliable software solutions and the skills to use them effectively. We work to make quality technology achievable — not just for enterprises, but for growing businesses everywhere.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-site mx-auto w-full px-6 md:px-8">
      <div class="reveal"><SectionHeading label="Values" title="What guides us" /></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger">
        {[
          { title: 'Quality', desc: 'We take pride in our craft. Every solution we build reflects our commitment to code that is clean, tested, and maintainable.' },
          { title: 'Practicality', desc: 'Technology should solve problems, not create them. We focus on solutions that actually work in the real world.' },
          { title: 'Transparency', desc: 'Clear communication, honest assessments, and predictable delivery. No surprises, no hidden complexities.' },
          { title: 'Partnership', desc: 'We invest in relationships, not transactions. Your long-term success is how we measure our own.' },
          { title: 'Value', desc: 'Quality does not have to mean expensive. We deliver professional solutions at fair, competitive pricing.' },
          { title: 'Growth', desc: 'Technology evolves constantly. We stay current so our clients always benefit from modern approaches.' },
        ].map((v) => (
          <div class="reveal card-surface p-6">
            <h3 class="text-[14px] font-display font-normal text-text-primary mb-2">{v.title}</h3>
            <p class="text-[13px] text-text-muted leading-relaxed font-light">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PartnerLogos />
  <CTABanner headline="Interested in working together?" subtitle="Let's discuss how Omaxil Tech can help with your technology needs." buttonLabel="Contact Us" />
</Layout>
